# ---------- public identity ----------
# The URL users reach the app on. Used for cookies, links and CORS.
PUBLIC_URL=http://192.168.1.9:3000

# ---------- secrets ----------
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-openssl-rand-hex-32

# ---------- database ----------
POSTGRES_USER=comfy
POSTGRES_PASSWORD=comfy
POSTGRES_DB=comfy_studio
DATABASE_URL=postgres://comfy:comfy@postgres:5432/comfy_studio

# ---------- redis ----------
REDIS_URL=redis://redis:6379

# ---------- storage ----------
# local  = a docker volume on this host (default, no extra services)
# s3     = any S3-compatible endpoint, including MinIO (docker compose --profile minio up)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/assets
S3_ENDPOINT=http://minio:9000
S3_BUCKET=comfy-studio
S3_ACCESS_KEY=comfy
S3_SECRET_KEY=comfy-secret
S3_REGION=us-east-1
# MinIO and most self-hosted gateways only serve path-style URLs; set false for
# real AWS S3 with virtual-host addressing.
S3_FORCE_PATH_STYLE=true
# Longest edge of the thumbnail generated for every asset, in pixels.
STORAGE_THUMB_MAX_PX=512
# How long to wait for one finished image to download from a ComfyUI backend.
# Much longer than the 8s status timeout: the box may still be busy generating.
STORAGE_FETCH_TIMEOUT_MS=120000

# ---------- uploads ----------
# Largest reference image POST /api/uploads will accept, in bytes. Enforced on
# the multipart stream, so an oversized file is refused mid-transfer rather
# than buffered first. Only PNG, JPEG and WebP are accepted, and that is
# decided by decoding the file, not by its name or declared content-type.
UPLOAD_MAX_BYTES=20971520
# Largest decoded image, in megapixels. The byte cap alone does not bound
# memory: a small PNG of flat colour can decode to gigabytes of pixels.
UPLOAD_MAX_MEGAPIXELS=64

# ---------- comfyui backends ----------
# Comma-separated list of name=url pairs. These are seeded on first boot;
# after that, manage them in the admin UI.
#
# ComfyUI on ANOTHER machine on your LAN (most common):
#   COMFY_BACKENDS=desktop-4090=http://192.168.1.50:8188
# ComfyUI on the SAME machine as this stack:
#   Linux  -> use the LAN IP, or add `extra_hosts` (see docker-compose.yml)
#   Mac/Win-> COMFY_BACKENDS=local=http://host.docker.internal:8188
COMFY_BACKENDS=desktop-4090=http://192.168.1.50:8188

# ---------- accounts ----------
# Set both to have an admin created on first boot. Leave blank to use the
# setup link the api prints on its first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to false once your users have signed up to close the door behind them.
ALLOW_REGISTRATION=true

# ---------- model downloads (optional) ----------
CIVITAI_API_KEY=
HUGGINGFACE_TOKEN=

# ---------- comfyui storage helper ----------
# Shared secret for the comfyui-rippel-storage node on each backend
# (tools/comfyui-rippel-storage). The helper answers 503 until the SAME value is
# set for the ComfyUI process, so it is never open by default. Leave blank and
# the Storage view reports the helper as unauthorised rather than sending an
# empty token — and Deployment refuses to install one, since it would install a
# helper rippel could not then use.
#   openssl rand -hex 32
COMFY_STORAGE_TOKEN=

# ---------- deployment ----------
# Where a rippel *agent* on a remote machine should check in.
#
# This is not PUBLIC_URL. PUBLIC_URL is where a browser reaches rippel, which
# behind a reverse proxy is often a name only the browser's network resolves.
# The agent runs on the GPU box and needs the address *it* can reach — on a home
# LAN those are routinely different. Blank falls back to PUBLIC_URL, which is
# right for a simple single-machine install.
#   AGENT_SERVER_URL=http://192.168.1.9:4000
AGENT_SERVER_URL=

# Port a newly installed agent listens on, and rippel dials it on.
AGENT_PORT=8189
# How long to wait for one call to an agent. Installs are not held open for
# this: they return a task id immediately and are polled.
AGENT_TIMEOUT_MS=15000
# How long an agent may go quiet before it is shown as offline. Three missed
# twenty-second beats, so one slow tick is not an outage.
AGENT_OFFLINE_AFTER_MS=70000
# Longest a managed SSH install may run before it is given up on. Installing
# torch on a slow link genuinely takes ten minutes.
SSH_TIMEOUT_MS=900000
# GitHub repo the agent's releases are published from, for the download links
# on the manual-install panel.
AGENT_RELEASE_REPO=frogg-app/rippel
