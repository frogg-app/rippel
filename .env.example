# ---------- public identity ----------
# The URL users reach the app on. Used for cookies, links and CORS.
PUBLIC_URL=http://192.168.1.9:3000

# ---------- secrets ----------
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-openssl-rand-hex-32

# ---------- database ----------
POSTGRES_USER=comfy
POSTGRES_PASSWORD=comfy
POSTGRES_DB=comfy_studio
DATABASE_URL=postgres://comfy:comfy@postgres:5432/comfy_studio

# ---------- redis ----------
REDIS_URL=redis://redis:6379

# ---------- storage ----------
# local  = a docker volume on this host (default, no extra services)
# s3     = any S3-compatible endpoint, including MinIO (docker compose --profile minio up)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/assets
S3_ENDPOINT=http://minio:9000
S3_BUCKET=comfy-studio
S3_ACCESS_KEY=comfy
S3_SECRET_KEY=comfy-secret
S3_REGION=us-east-1

# ---------- comfyui backends ----------
# Comma-separated list of name=url pairs. These are seeded on first boot;
# after that, manage them in the admin UI.
#
# ComfyUI on ANOTHER machine on your LAN (most common):
#   COMFY_BACKENDS=desktop-4090=http://192.168.1.50:8188
# ComfyUI on the SAME machine as this stack:
#   Linux  -> use the LAN IP, or add `extra_hosts` (see docker-compose.yml)
#   Mac/Win-> COMFY_BACKENDS=local=http://host.docker.internal:8188
COMFY_BACKENDS=desktop-4090=http://192.168.1.50:8188

# ---------- accounts ----------
# Set both to have an admin created on first boot. Leave blank to use the
# setup link the api prints on its first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to false once your users have signed up to close the door behind them.
ALLOW_REGISTRATION=true

# ---------- model downloads (optional) ----------
CIVITAI_API_KEY=
HUGGINGFACE_TOKEN=
